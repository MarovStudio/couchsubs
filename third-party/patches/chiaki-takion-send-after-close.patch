 	ChiakiThread thread;
 } ChiakiTakionSendBuffer;
 
diff --git a/lib/src/takionsendbuffer.c b/lib/src/takionsendbuffer.c
index 5cee13cf..cf4549f9 100644
--- a/lib/src/takionsendbuffer.c
