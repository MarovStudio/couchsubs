<UserControl x:Class="CouchSubs.App.Views.Steps.TvStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Tv}" Title="{t:T 'Connect your TV'}"
                  Message="{t:T 'Turn on the TV and open the CouchSubs TV app. When you press Connect, the TV asks for permission once — accept it with the remote.'}">
        <StackPanel>
            <TextBlock x:Name="Done" Style="{StaticResource DoneText}" Margin="0,0,0,16" />
            <c:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="TV" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" />
                        <Button x:Name="Search" Content="{t:T 'Search again'}" HorizontalAlignment="Right" Click="OnSearch" />
                    </Grid>
                    <TextBlock x:Name="NotFound" Style="{StaticResource HintText}" Text="{t:T 'No LG TV found. Make sure the TV is on and on the same network.'}" />
                    <StackPanel x:Name="Tvs" />
                </StackPanel>
            </c:Card>
            <TextBlock x:Name="Waiting" Style="{StaticResource HintText}" Margin="0,16,0,0" Visibility="Collapsed"
                       Text="{t:T 'Accept the request on the TV…'}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                       Text="{t:T 'If Windows asks whether CouchSubs may use the network, allow it for private networks.'}" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>
    </c:StepLayout>
</UserControl>
