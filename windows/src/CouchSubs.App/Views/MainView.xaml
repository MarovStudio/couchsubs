<UserControl x:Class="CouchSubs.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <!-- Başlık: logo, ad, ayarlar -->
            <Grid Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="CouchSubs" Style="{StaticResource TitleText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" ToolTip="{t:T 'Settings'}" Click="OnSettings">
                    <TextBlock Text="{x:Static c:Glyphs.Settings}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="{DynamicResource textSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Başlat / Durdur -->
            <Button x:Name="Toggle" HorizontalAlignment="Stretch" MinHeight="52" Click="OnToggle"
                    IsEnabled="{Binding IsStarting, Converter={StaticResource Not}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ToggleGlyph" Style="{StaticResource GlyphText}" FontSize="16" Margin="0,0,10,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock x:Name="ToggleText" FontSize="{DynamicResource headlineFontSize}" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>

            <!-- Durumlar -->
            <c:Card Margin="0,24,0,0">
                <StackPanel>
                    <c:StatusRow Title="PS5" Value="{Binding Ps5StatusText}" IsGood="{Binding Ps5Good}" />
                    <Separator />
                    <c:StatusRow Title="TV" Value="{Binding TvStatusText}" IsGood="{Binding TvGood}" />
                </StackPanel>
            </c:Card>

            <!-- Çeviri modeli eksik -->
            <c:Card x:Name="ModelCard" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{t:T 'The translation model is not downloaded yet.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                    <StackPanel Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}}" Margin="0,12,0,0">
                        <TextBlock Text="{t:T 'Downloading…'}" Style="{StaticResource HintText}" Margin="0,0,0,8" />
                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelProgress, Mode=OneWay}" />
                    </StackPanel>
                    <Button Content="{t:T 'Download the model'}" Margin="0,12,0,0" Click="OnDownload"
                            Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                </StackPanel>
            </c:Card>

            <!-- Yazı tanıma dili eksik -->
            <c:Card Margin="0,16,0,0" Visibility="{Binding OcrMissing, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <TextBlock Text="{t:T 'Text recognition for the game language is not installed on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource warningBrush}" />
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,12"
                               Text="{t:T 'Open Settings › Time &amp; language › Language &amp; region, add English and select its optical character recognition feature.'}" />
                    <Button Content="{t:T 'Open language settings'}" Click="OnLanguageSettings" />
                </StackPanel>
            </c:Card>

            <!-- Son altyazı -->
            <c:Card Title="{t:T 'Last subtitle'}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{t:T 'Subtitles will appear here while you play.'}" Style="{StaticResource HintText}"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    <TextBlock Text="{Binding LastTranslation}" Style="{StaticResource TitleText}" FontWeight="Medium"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Text="{Binding LastSource}" Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Visibility="{Binding LastTranslation, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
