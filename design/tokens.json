{
  "name": "CouchSubs",
  "version": 1,
  "color": {
    "background":    { "light": "#F6F4EF", "dark": "#141518" },
    "surface":       { "light": "#FFFFFF", "dark": "#1E2024" },
    "border":        { "light": "#E2DED4", "dark": "#30333A" },
    "textPrimary":   { "light": "#17181B", "dark": "#F3EEE4" },
    "textSecondary": { "light": "#5B5954", "dark": "#A9A59C" },
    "accent":        { "light": "#F5B83D", "dark": "#F5B83D" },
    "onAccent":      { "light": "#17181B", "dark": "#17181B" },
    "accentText":    { "light": "#7E5300", "dark": "#F5B83D" },
    "accentSoft":    { "light": "#FBEBC8", "dark": "#3A3020" },
    "success":       { "light": "#256B43", "dark": "#62C990" },
    "warning":       { "light": "#9A4A08", "dark": "#F2A55A" },
    "danger":        { "light": "#B3261E", "dark": "#F28B82" },
    "onDanger":      { "light": "#FFFFFF", "dark": "#17181B" }
  },
  "fontFamily": { "mac": "SF Pro (sistem)", "windows": "Segoe UI Variable" },
  "font": {
    "display":  { "size": 30, "weight": "semibold" },
    "title":    { "size": 22, "weight": "semibold" },
    "headline": { "size": 17, "weight": "semibold" },
    "body":     { "size": 15, "weight": "regular" },
    "callout":  { "size": 14, "weight": "regular" },
    "caption":  { "size": 12, "weight": "regular" },
    "button":   { "size": 15, "weight": "semibold" },
    "code":     { "size": 22, "weight": "semibold" }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24, "xxl": 32 },
  "radius": { "control": 10, "card": 14 },
  "size": { "buttonHeight": 44, "iconBadge": 48, "statusDot": 10, "windowWidth": 640, "windowHeight": 720 }
}
